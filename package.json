{
  "name": "deepseek-desktop",
  "version": "1.0.8",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/smoke-test.js",
    "lint": "eslint main.js preload.js inject.js popup-inject.js ui/*.js scripts/*.js",
    "build": "electron-builder --publish never"
  },
  "keywords": [],
  "author": "xmbl4399",
  "license": "MIT",
  "description": "DeepSeek 官方网页版桌面客户端(悬浮球 + 右键截图提问 + 对话小浮框)",
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xmbl4399/deepseek-desktop"
  },
  "publish": {
    "provider": "github",
    "owner": "xmbl4399",
    "repo": "deepseek-desktop",
    "releaseType": "release"
  },
  "build": {
    "appId": "com.deepseek.desktop",
    "productName": "DeepSeek Desktop",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "inject.js",
      "popup-inject.js",
      "ui/**/*",
      "!ui/**/*.bak"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "shortcutName": "DeepSeek",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "ui/logo.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "ui/logo.png"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
