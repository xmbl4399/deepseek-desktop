{
  "name": "deepseek-desktop",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "electron-builder"
  },
  "keywords": [],
  "author": "doxdk",
  "license": "ISC",
  "description": "DeepSeek 官方网页版桌面客户端(悬浮球 + 右键截图提问 + 对话小浮框)",
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/doxdk/deepseek-desktop"
  },
  "build": {
    "appId": "com.deepseek.desktop",
    "productName": "DeepSeek Desktop",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "index.html",
      "preload.js",
      "inject.js",
      "popup-inject.js",
      "ui/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "ui/logo.png"
    },
    "nsis": {
      "shortcutName": "DeepSeek",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "ui/logo.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "ui/logo.png"
    }
  }
}